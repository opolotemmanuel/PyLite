# Demonstrates the new max() and min() builtins.

let a = 3
let b = 7
print("max:", max(a, b))
print("min:", min(a, b))

# Negative numbers
print(max(-1, -5))
print(min(-1, -5))

# Floats
print(max(2.5, 1.0), min(2.5, 1.0))

# Pipelines feed one argument, so max/min need a bare call.
# This doubles 10 -> 20, then pipes 20 into max(15, 20) via a helper expression.
let doubled = 10 |> double_value
print(max(doubled, 15))
